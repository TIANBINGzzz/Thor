# Docker Compose raw env_file: write literal values, without surrounding quotes.
ANTHROPIC_AUTH_TOKEN=YOUR_MODEL_API_KEY
ANTHROPIC_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=qwen3.7-flash
SCRIBE_MODELS=qwen3.7-flash,qwen3.7-plus
# Optional Qwen Image 3.0; literal same-region credentials (no env interpolation here).
# CCSDK_IMAGE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# CCSDK_IMAGE_API_KEY=YOUR_IMAGE_API_KEY
# CCSDK_IMAGE_MODEL=qwen-image-3.0
# Required: set a nonempty shared secret, identical to the Java configuration.
CCSDK_RUNTIME_JWT_SECRET=
CCSDK_RUNTIME_JWT_AUDIENCE=ccsdk-runtime
CCSDK_RUNTIME_JWT_ISSUER=string-ai-center-service
# Optional: configure an accessible HTTPS File Broker for attachment input.
# CCSDK_FILE_BROKER_URL=https://java.example.internal/internal/v1/file-access/grant
# CCSDK_FILE_BROKER_ALLOWED_HOSTS=objects.example.internal
# Do not copy a workstation's localhost proxy into a container.
