{
  "connection": {
    "url": "${campusMcp.url}",
    "headers": {
      "app-key": "inter-page-key",
      "domain-name": "${campusMcp.domainName}"
    }
  },
  "max_calls": 10,
  "catalogs": {
    "indicator_compare": "indicator_compare.csv",
    "norm_analysis": "norm_analysis.csv",
    "schools": "schools.csv"
  },
  "tools": {
    "get_school_info": {
      "output_fields": [
        "school_id",
        "school_name"
      ]
    },
    "get_indicator_metrics": {
      "catalog": "indicator_compare",
      "output_fields": [
        "indicator_value",
        "province_rank",
        "province_median",
        "national_median",
        "same_type_rank",
        "same_type_median",
        "national_double_high_median",
        "province_double_high_median",
        "national_double_high_simulated_rank",
        "province_double_high_simulated_rank",
        "private_median",
        "year",
        "rank_type",
        "school_count",
        "cohort_size",
        "percentile"
      ]
    },
    "get_norm_metrics": {
      "catalog": "norm_analysis",
      "output_fields": [
        "indicator_value",
        "median",
        "rank",
        "max_value",
        "min_value",
        "average_value",
        "school_count",
        "year"
      ]
    }
  },
  "minimum_schools": 8
}
