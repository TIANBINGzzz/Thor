{
  "ref": "documents",
  "version": 1,
  "implementation": "documents",
  "transport": "sdk",
  "lifecycle": "per_run",
  "scope": "operations",
  "description": "读取、转换和核验文档",
  "operations": [
    {
      "ref": "render",
      "description": "Office引擎更新DOCX已有目录字段，另存DOCX与PDF，并在preview直接返回前20页文字、pageCount、imagePath及nextStart；用Read查看图片逐页核验，无需重复read_pdf；nextStart非空时继续read_pdf其余页。不会从静态目录文字创建TOC。output_dir为新目录。OfficeCLI编辑后先close；需要目录时tocStatus=not_present表示未通过，须修复字段再渲染。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "output_dir"
        ],
        "additionalProperties": false
      }
    },
    {
      "ref": "read_pdf",
      "description": "按页读取PDF文字，可render=true生成页面图片。页码从1开始；用Read查看返回图片。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "start": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "render": {
            "type": "boolean"
          },
          "output_dir": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  ],
  "category": "document",
  "auth": {
    "required": false
  },
  "displayKeys": {
    "render": "document.preview",
    "read_pdf": "document.read"
  }
}
