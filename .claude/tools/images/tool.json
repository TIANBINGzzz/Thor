{
  "ref": "images",
  "version": 1,
  "implementation": "images",
  "transport": "sdk",
  "lifecycle": "per_run",
  "scope": "operations",
  "description": "图像生成和图像编辑",
  "operations": [
    {
      "ref": "generate",
      "description": "生成或编辑一张图片，保存 PNG 并返回 path。用 Read 查看结果。需要向用户单独展示或交付图片时，在本轮回复前逐张调用 mcp__artifacts__publish_file，将返回的 path 作为 source_path 提交。reference_paths 可选 1 至 3 张本轮授权参考图。生成图不能作为真实成果照片或数据证据。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "output_path": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "reference_paths": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "prompt",
          "output_path"
        ],
        "additionalProperties": false
      }
    }
  ],
  "category": "image",
  "auth": {
    "required": false
  },
  "displayKeys": {
    "generate": "image.generate"
  }
}
