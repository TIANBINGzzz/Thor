{
  "ref": "office",
  "version": 1,
  "implementation": "stdio-mcp",
  "transport": "stdio",
  "lifecycle": "per_run",
  "scope": "namespace",
  "description": "OfficeCLI 原生文档编辑。MCP 的 command 使用字符串数组；新稿先准备全文及格式 JSON，再 create → batch → close，最后通过 documents 渲染核验。完整最小用法见本轮注入的 TOOL.md。",
  "operations": [],
  "category": "document",
  "auth": {
    "required": false
  },
  "displayKeys": {
    "officecli": "document.process"
  },
  "connection": {
    "command": {
      "env": "CCSDK_OFFICECLI_PATH",
      "default": "officecli"
    },
    "args": [
      "mcp"
    ],
    "env": {
      "OFFICECLI_SKIP_UPDATE": "1"
    }
  },
  "instructionRefs": [
    "TOOL.md"
  ]
}
