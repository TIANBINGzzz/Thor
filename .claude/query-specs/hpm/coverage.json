{
  "source_key": "qa_db",
  "defaults": "未列出的参数按 QuerySpec 显式绑定；Q1/Q13/Q15 年度来自用户，Q9-Q11 部门须唯一解析，Q17 专业群项目须唯一解析并授权",
  "questions": {
    "Q1": {
      "query_id": "task_level_counts",
      "bindings": {},
      "result": "task_level/task_count"
    },
    "Q2": {
      "query_id": "task_progress_summary",
      "bindings": {
        "level": 3,
        "threshold": 50
      },
      "result": "avg_progress"
    },
    "Q3": {
      "query_id": "completed_task_count",
      "bindings": {},
      "result": "completed_count"
    },
    "Q4": {
      "query_id": "task_progress_summary",
      "bindings": {
        "level": 3,
        "threshold": 50
      },
      "result": "threshold_count/threshold_rate"
    },
    "Q5": {
      "query_id": "task_progress_summary",
      "bindings": {
        "level": 3,
        "threshold": 50
      },
      "result": "zero_or_missing_count"
    },
    "Q6": {
      "query_id": "completed_tasks_without_material",
      "bindings": {},
      "result": "missing_material_count"
    },
    "Q7": {
      "query_id": "task_department_metrics",
      "bindings": {
        "level": null
      },
      "result": "结果部门行数"
    },
    "Q8": {
      "query_id": "task_department_metrics",
      "bindings": {
        "level": null
      },
      "result": "completed_count=0 的部门行数"
    },
    "Q9": {
      "query_id": "task_department_metrics",
      "bindings": {
        "level": 3
      },
      "result": "task_count"
    },
    "Q10": {
      "query_id": "task_department_metrics",
      "bindings": {
        "level": 3
      },
      "result": "completed_count"
    },
    "Q11": {
      "query_id": "task_department_metrics",
      "bindings": {
        "level": 3
      },
      "result": "completion_rate+avg_progress"
    },
    "Q12": {
      "query_id": "task_department_metrics",
      "bindings": {
        "level": null
      },
      "result": "progress_rank；披露所有层级默认，明确三级时改3"
    },
    "Q13": {
      "query_id": "fund_totals",
      "bindings": {},
      "result": "budget_amount+budget_observed_count+fund_count"
    },
    "Q14": {
      "query_id": "fund_totals",
      "bindings": {
        "year": null
      },
      "result": "budget_execution_rate"
    },
    "Q15": {
      "query_id": "fund_totals",
      "bindings": {},
      "result": "budget_execution_rate"
    },
    "Q16": {
      "query_id": "fund_department_coverage",
      "bindings": {},
      "result": "coverage_rate+zero_execute_department_count+未填报诊断"
    },
    "Q17": {
      "query_id": "performance_current_summary",
      "bindings": {},
      "result": "avg_progress+reached_rate"
    },
    "Q18": {
      "query_id": "performance_current_summary",
      "bindings": {},
      "result": "not_reached_count"
    }
  },
