{
  "id": "performance_feedback_candidates",
  "name": "已审核绩效反馈版本候选",
  "description": "返回年度/累计目标和完成值及材料提示；提交时间只用于筛候选，不自动认定业务年度或适用历史版本。",
  "status": "defined",
  "source_keys": [
    "qa_db",
    "report_db"
  ],
  "dialect": "mysql8",
  "grain": "project + performance + feedback",
  "parameters": {
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "所声明时间字段的不含终点，ISO 日期/时间；null 不限制"
    },
    "performance_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已解析指标主键；null 为已授权范围内的全部指标"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "所声明时间字段的含起点，ISO 日期/时间；null 不限制，不能据提交时间推断业务年度"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    }
  },
  "tables": [
    "t_hpm_project",
    "t_hpm_project_module",
    "t_hpm_project_performance",
    "t_hpm_project_performance_feedback"
  ],
  "sql_file": "sql/performance_feedback_candidates.sql",
  "output": [
    {
      "name": "feedback_id",
      "description": "反馈内部键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "project_id",
      "description": "项目键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "performance_id",
      "description": "绩效键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "performance_name",
      "description": "指标名称",
      "type": "string",
      "nullable": true
    },
    {
      "name": "submitted_at",
      "description": "提交时间，非业务年度或审核生效日期",
      "type": "string",
      "nullable": true
    },
    {
      "name": "year_target_value",
      "description": "反馈版本年度目标原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "year_complete_value",
      "description": "反馈版本年度完成原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "total_target_value",
      "description": "同版本累计目标原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "total_complete_value",
      "description": "同版本累计完成原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "year_progress",
      "description": "反馈版本年度进度",
      "type": "number",
      "nullable": true,
      "unit": "%"
    },
    {
      "name": "total_progress",
      "description": "反馈版本累计进度",
      "type": "number",
      "nullable": true,
      "unit": "%"
    },
    {
      "name": "content",
      "description": "已审核反馈内容",
      "type": "string",
      "nullable": true
    },
    {
      "name": "has_attachment",
      "description": "是否存在候选附件",
      "type": "integer",
      "nullable": false
    }
  ],
  "semantics": [
    "同一版本年度值与累计值成对使用；跨版本或跨年累计值不能相加",
    "start/end 仅过滤 create_time_；历史适用版本需报告库业务年度和审核生效规则，未确定时不回填",
    "附件交由 File Broker 授权，不能输出原始 attachment_ 地址"
  ],
  "prerequisites": [
    "授权租户与项目范围已由服务端确定；不能从库内发现的租户值推导用户权限",
    "先执行 performance_module_status；所选项目存在 module_count!=1 或无效 stage_flag 时停止，不能将过滤后的子集当全量"
  ],
  "validation": [
    "返回候选并不代表已选定年度快照；不能 ORDER BY create_time DESC LIMIT 1 代替版本确认"
  ],
  "evidence": [
    ".claude/workflows/database-qa/semantics/metric-definitions.md",
    ".claude/workflows/database-qa/semantics/join-rules.md",
    ".claude/workflows/writing-docx/templates/szpt-midterm/深圳职业技术学院双高计划中期自评报告规范化模板数据来源.md",
    ".claude/workflows/database-qa/semantics/tables/t_hpm_project.md",
    ".claude/workflows/database-qa/semantics/tables/t_hpm_project_module.md",
    ".claude/workflows/database-qa/semantics/tables/t_hpm_project_performance.md",
    ".claude/workflows/database-qa/semantics/tables/t_hpm_project_performance_feedback.md"
  ],
  "verification": {
    "qa_db": {
      "date": "2026-09-14",
      "method": "MySQL read-only zero-row projection of full query; output aliases checked",
      "result": "passed",
      "numeric_baseline": "not_checked"
    },
    "report_db": "connection_unbound"
  },
  "version": 1,
  "path_base": "query_catalog_root",
  "result_policy": {
    "internal_keys": "只用于取数、去重和授权材料解析，不进入正文、公共事件或普通日志",
    "completeness": "执行端必须标记结果是否完整；发现行数截断时分页或缩小授权范围，不把部分行作全量聚合",
    "nulls": "无记录、未填报和数值0分别处理；以本资产的数量/非空数量和语义说明为准"
  },
  "requires_queries": [
    "performance_module_status"
  ]
}
