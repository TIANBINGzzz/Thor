{
  "id": "report_performance_titles",
  "name": "报告库绩效一级二级标题",
  "description": "按原报告库 first_item_id_/second_item_id_ 关联标题；保留独立来源，不用问数库 parent_id_ 替代。",
  "status": "blocked",
  "source_keys": [
    "report_db"
  ],
  "dialect": "mysql8",
  "grain": "project + performance",
  "parameters": {
    "performance_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_resolution",
      "description": "已解析指标主键；null 为已授权范围内的全部指标"
    },
    "project_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    }
  },
  "tables": [
    "t_hpm_project",
    "t_hpm_project_performance"
  ],
  "sql_file": "sql/report_performance_titles.sql",
  "output": [
    {
      "name": "project_id",
      "description": "项目键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "performance_id",
      "description": "绩效键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "performance_name",
      "description": "具体指标名",
      "type": "string",
      "nullable": true
    },
    {
      "name": "first_title",
      "description": "一级分类名",
      "type": "string",
      "nullable": true
    },
    {
      "name": "second_title",
      "description": "二级分类名",
      "type": "string",
      "nullable": true
    },
    {
      "name": "current_target_value",
      "description": "当前目标原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "current_finish_value",
      "description": "当前完成原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "current_progress",
      "description": "当前进度",
      "type": "number",
      "nullable": true,
      "unit": "%"
    }
  ],
  "semantics": [],
  "prerequisites": [
    "授权租户与项目范围已由服务端确定；不能从库内发现的租户值推导用户权限"
  ],
  "validation": [
    "精确主键查询至多1条；标题未匹配保持空值并确认"
  ],
  "evidence": [
    ".claude/workflows/database-qa/semantics/metric-definitions.md",
    ".claude/workflows/database-qa/semantics/join-rules.md",
    ".claude/workflows/writing-docx/templates/szpt-midterm/深圳职业技术学院双高计划中期自评报告规范化模板数据来源.md",
    ".claude/workflows/database-qa/semantics/tables/t_hpm_project.md",
    ".claude/workflows/database-qa/semantics/tables/t_hpm_project_performance.md"
  ],
  "verification": {
    "qa_db": "not_applicable",
    "report_db": "connection_unbound"
  },
  "blockers": [
    "报告库连接及该源字段授权尚未配置；SQL 按原来源固化，尚未在报告库验证",
    "绩效主键须由报告库已核验的模块/阶段/任务关系绑定得到，不能任意选择历史版本"
  ],
  "version": 1,
  "path_base": "query_catalog_root",
  "result_policy": {
    "internal_keys": "只用于取数、去重和授权材料解析，不进入正文、公共事件或普通日志",
    "completeness": "执行端必须标记结果是否完整；发现行数截断时分页或缩小授权范围，不把部分行作全量聚合",
    "nulls": "无记录、未填报和数值0分别处理；以本资产的数量/非空数量和语义说明为准"
  }
}
