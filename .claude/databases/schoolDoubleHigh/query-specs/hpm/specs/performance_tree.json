{
  "id": "performance_tree",
  "name": "问数库绩效分类树和当前值",
  "description": "返回分类及真实指标；问数库使用 parent_id_ 组装路径，不能作为报告库的标题关系替代。",
  "status": "defined",
  "dialect": "mysql8",
  "grain": "project + performance node",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    }
  },
  "tables": [
    "t_hpm_project",
    "t_hpm_project_performance"
  ],
  "sql_file": "sql/performance_tree.sql",
  "output": [
    {
      "name": "project_id",
      "description": "项目键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "performance_id",
      "description": "绩效键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "stage_id",
      "description": "阶段键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "parent_id",
      "description": "父指标键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "performance_code",
      "description": "业务编码",
      "type": "string",
      "nullable": true
    },
    {
      "name": "performance_name",
      "description": "指标/分类名",
      "type": "string",
      "nullable": true
    },
    {
      "name": "performance_level",
      "description": "1/2 分类，>=3 实绩节点",
      "type": "integer",
      "nullable": true
    },
    {
      "name": "target_value",
      "description": "当前目标原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "finish_value",
      "description": "当前完成原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "current_progress",
      "description": "当前进度",
      "type": "number",
      "nullable": true,
      "unit": "%"
    }
  ],
  "semantics": [
    "目录数据包含全部节点，不直接聚合；实际取值需 module_status 和模块阶段规则",
    "沿同项目父键恢复分类路径并检查环和缺父节点；阶段为空的分类可被该项目有阶段实绩节点引用"
  ],
  "prerequisites": [
    "授权租户与项目范围已由服务端确定；不能从库内发现的租户值推导用户权限"
  ],
  "validation": [
    "不能仅按指标名或编码唯一定位；完成/目标原文不能强制转数值"
  ],
  "evidence": [
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/metric-definitions.md",
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/join-rules.md",
    ".claude/workflows/writing-docx/templates/szpt-midterm/深圳职业技术学院双高计划中期自评报告规范化模板数据来源.md",
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/tables/t_hpm_project.md",
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/tables/t_hpm_project_performance.md"
  ],
  "verification": {
    "qa_db": {
      "date": "2026-09-14",
      "method": "MySQL read-only zero-row projection of full query; output aliases checked",
      "result": "passed",
      "numeric_baseline": "not_checked"
    },
    "report_db": "not_applicable"
  },
  "version": 1,
  "path_base": "query_catalog_root",
  "result_policy": {
    "internal_keys": "只用于取数、去重和授权材料解析，不进入正文、公共事件或普通日志",
    "completeness": "执行端必须标记结果是否完整；发现行数截断时分页或缩小授权范围，不把部分行作全量聚合",
    "nulls": "无记录、未填报和数值0分别处理；以本资产的数量/非空数量和语义说明为准"
  },
  "batch": {
    "mode": "scalar_expansion"
  }
}
