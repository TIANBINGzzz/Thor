{
  "id": "report_task_sections",
  "name": "报告一级建设指标与期内反馈覆盖",
  "description": "一级任务即建设章节；下钻三级任务，统计指定年度截至日窗口的已审核反馈。",
  "status": "defined",
  "dialect": "mysql8",
  "grain": "authorized project and declared period",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "required": true,
      "origin": "user_intent"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "required": true,
      "origin": "user_intent"
    }
  },
  "tables": [
    "t_hpm_project_stage",
    "t_hpm_project_task",
    "t_hpm_project_task_feedback"
  ],
  "sql_file": "sql/report_task_sections.sql",
  "output": [
    {
      "name": "first_task_id",
      "description": "一级任务键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "section_code",
      "description": "建设章节业务编码",
      "type": "string",
      "nullable": true
    },
    {
      "name": "section_name",
      "description": "建设章节标题",
      "type": "string",
      "nullable": true
    },
    {
      "name": "task_count",
      "description": "下属三级任务数",
      "type": "integer",
      "nullable": true
    },
    {
      "name": "current_average_progress",
      "description": "主表当前平均进度，不是历史实绩",
      "type": "number",
      "nullable": true,
      "unit": "%"
    },
    {
      "name": "period_feedback_count",
      "description": "期内已审核反馈记录数，不是成果数",
      "type": "integer",
      "nullable": true
    }
  ],
  "semantics": [
    "一级任务即建设章节；下钻三级任务，统计指定年度截至日窗口的已审核反馈。",
    "当前主表数值不能作为历史截止日实绩；无记录、NULL、0分别保留。",
    "详见 semantics/report-lineage.md；同项目及租户关联，内部ID不进入报告。"
  ],
  "prerequisites": [
    "授权租户与项目范围已由服务端确定；不能从库内发现的租户值推导用户权限"
  ],
  "validation": [
    "task_id 在项目内唯一；标题必须唯一命中后使用"
  ],
