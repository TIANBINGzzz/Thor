      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "stage_flag",
      "description": "1 分阶段，0 不分阶段；仅 module_count=1 时可用",
      "type": "string",
      "nullable": true
    },
    {
      "name": "distinct_flag_count",
      "description": "不同非空开关数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    }
