{
  "id": "performance_module_status",
  "name": "绩效模块口径诊断",
  "description": "逐项目返回模块数量和阶段开关；绩效查询前检查缺失、重复或无效开关。",
  "status": "defined",
  "dialect": "mysql8",
  "grain": "project",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    }
  },
  "tables": [
    "t_hpm_project",
    "t_hpm_project_module"
  ],
  "sql_file": "sql/performance_module_status.sql",
