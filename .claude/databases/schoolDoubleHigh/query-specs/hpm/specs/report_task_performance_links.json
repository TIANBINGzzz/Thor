{
  "id": "report_task_performance_links",
  "name": "年度任务到绩效关联",
  "description": "按模块开关关联有阶段或无阶段绩效；分类回溯使用 first_item_id_/second_item_id_。",
  "status": "defined",
  "dialect": "mysql8",
  "grain": "authorized project and declared period",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    }
  },
  "tables": [
    "t_hpm_project",
    "t_hpm_project_stage",
    "t_hpm_project_module",
    "t_hpm_project_task",
    "t_hpm_project_task_performance_relation",
    "t_hpm_project_performance"
  ],
  "sql_file": "sql/report_task_performance_links.sql",
  "output": [
