{
  "id": "fund_source_amounts",
  "name": "资金七类来源与四类金额",
  "description": "沉淀 28 个资金字段，返回总额及六类来源；来源中文标签由具体数据源字典决定。",
  "status": "defined",
  "dialect": "mysql8",
  "grain": "funding source kind",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    }
  },
  "tables": [
    "t_hpm_project",
    "t_hpm_project_fund",
    "t_hpm_project_stage"
  ],
  "sql_file": "sql/fund_source_amounts.sql",
  "output": [
    {
      "name": "source_kind",
      "description": "来源代码；total 为总额，不与分项相加",
      "type": "string",
      "nullable": false
    },
    {
      "name": "fund_count",
      "description": "资金节点数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "budget_amount",
      "description": "预算已填金额合计",
      "type": "number",
      "nullable": true,
      "unit": "万元"
    },
    {
      "name": "budget_observed_count",
      "description": "预算非空金额记录数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "investment_amount",
      "description": "投入已填金额合计",
      "type": "number",
      "nullable": true,
      "unit": "万元"
    },
    {
      "name": "investment_observed_count",
      "description": "投入非空金额记录数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "execute_amount",
      "description": "执行已填金额合计",
      "type": "number",
      "nullable": true,
      "unit": "万元"
    },
    {
      "name": "execute_observed_count",
      "description": "执行非空金额记录数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "arrival_amount",
      "description": "到位已填金额合计",
      "type": "number",
      "nullable": true,
      "unit": "万元"
    },
    {
      "name": "arrival_observed_count",
      "description": "到位非空金额记录数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "budget_execution_rate",
      "description": "完整执行合计/完整预算合计",
      "type": "number",
      "nullable": true,
      "unit": "%"
    },
    {
      "name": "arrival_rate",
      "description": "完整到位合计/完整预算合计",
      "type": "number",
      "nullable": true,
      "unit": "%"
    },
    {
      "name": "arrival_execution_rate",
      "description": "完整执行合计/完整到位合计",
      "type": "number",
      "nullable": true,
      "unit": "%"
    }
  ],
  "semantics": [
    "单位万元；一级资金节点且 stage_id_ 非空，排除父子层级和无阶段汇总重复",
    "year=null 汇总所有年度；年度记录的当前值不等于过去截止日快照",
    "SUM 保留 NULL：全无值为 null，部分有值是已填部分；observed_count<fund_count 不得宣称完整金额",
    "不将 NULL 金额补成 0；不将比例强制封顶；负金额只标记需核实，不臆造不允许冲销的业务规则",
    "qa_db.alone=其他来源；report_db.alone 保留原模板学校自筹标签，需该源字典确认",
    "无资金行时结果为空；来源分项与总额可核对差额，但不自行凑平，也不因跨源字典不同否定来源"
  ],
  "prerequisites": [
    "授权租户与项目范围已由服务端确定；不能从库内发现的租户值推导用户权限"
  ],
  "validation": [
    "source_kind 唯一；分项与总额分开；来源字典必须匹配 source_key"
  ],
  "evidence": [
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/metric-definitions.md",
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/join-rules.md",
    ".claude/workflows/writing-docx/templates/szpt-midterm/深圳职业技术学院双高计划中期自评报告规范化模板数据来源.md",
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/tables/t_hpm_project.md",
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/tables/t_hpm_project_fund.md",
    ".claude/databases/schoolDoubleHigh/query-specs/hpm/semantics/tables/t_hpm_project_stage.md"
  ],
  "verification": {
    "qa_db": {
      "date": "2026-09-14",
      "method": "MySQL read-only zero-row projection of full query; output aliases checked",
      "result": "passed",
      "numeric_baseline": "not_checked"
    },
    "report_db": "connection_unbound"
  },
  "version": 1,
  "path_base": "query_catalog_root",
  "result_policy": {
    "internal_keys": "只用于取数、去重和授权材料解析，不进入正文、公共事件或普通日志",
    "completeness": "执行端必须标记结果是否完整；发现行数截断时分页或缩小授权范围，不把部分行作全量聚合",
    "nulls": "无记录、未填报和数值0分别处理；以本资产的数量/非空数量和语义说明为准"
  },
  "batch": {
    "mode": "scalar_expansion"
  }
}
