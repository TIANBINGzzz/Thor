{
  "name": "任务负责人和参与人",
  "description": "按任务、人员、角色去重；人员部门不代替任务牵头部门。",
  "version": 1,
  "grain": "project + task + user + role",
  "parameters": {
    "member_type": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "enum": [
        "0",
        "1",
        null
      ],
      "origin": "user_intent",
      "description": "任务角色：0 负责人、1 参与人、null 全部；不能代替任务主部门"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已解析任务主键；null 为已授权范围的全部任务"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    }
  },
  "output": [
    {
      "name": "project_id",
      "description": "项目键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "task_id",
      "description": "任务键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "task_name",
      "description": "任务名称",
      "type": "string",
      "nullable": true
    },
    {
      "name": "user_id",
      "description": "用户键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "member_type",
      "description": "0 负责人，1 参与人",
      "type": "string",
      "nullable": true
    },
    {
      "name": "user_name",
      "description": "获准展示的姓名",
      "type": "string",
      "nullable": true
    },
    {
      "name": "name_variants",
      "description": "姓名版本数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    }
  ],
  "aliases": [
    "任务负责人",
    "任务参与人"
  ],
  "semantics": [
    "不将人员关系行数当任务数；姓名冲突须确认"
  ]
}
