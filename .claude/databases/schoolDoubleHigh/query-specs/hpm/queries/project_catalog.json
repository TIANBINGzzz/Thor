{
  "name": "国双高项目目录与标题",
  "description": "解析授权项目名称并取得封面/项目标题所需元数据，不将同名候选合并。",
  "version": 1,
  "grain": "project",
  "parameters": {
    "name_pattern": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "名称 LIKE 模式，参数值可含通配符；null 列出授权范围候选，不允许 LIMIT 1 消歧"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    }
  },
  "output": [
    {
      "name": "project_id",
      "description": "项目内部键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "project_name",
      "description": "项目名称",
      "type": "string",
      "nullable": true
    },
    {
      "name": "start_time",
      "description": "项目开始时间",
      "type": "string",
      "nullable": true
    },
    {
      "name": "end_time",
      "description": "项目结束时间",
      "type": "string",
      "nullable": true
    },
    {
      "name": "level_name",
      "description": "项目级别名称",
      "type": "string",
      "nullable": true
    },
    {
      "name": "current_progress",
      "description": "项目当前进度，不能替代任务均值",
      "type": "number",
      "nullable": true,
      "unit": "%"
    }
  ],
  "aliases": [
    "专业群",
    "双高项目",
    "项目名称"
  ],
  "semantics": [
    "名称解析必须唯一；0 条不放宽条件，多条消歧；项目主键仅内部使用"
  ]
}
