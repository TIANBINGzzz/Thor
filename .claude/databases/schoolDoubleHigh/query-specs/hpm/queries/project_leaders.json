{
  "name": "项目负责人名单",
  "description": "按项目+人员去重取得角色0负责人，仅明确询问且获准时用于报告。",
  "version": 1,
  "grain": "project + user",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    }
  },
  "output": [
    {
      "name": "project_id",
      "description": "项目键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "project_name",
      "description": "项目名",
      "type": "string",
      "nullable": true
    },
    {
      "name": "user_id",
      "description": "人员内部键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "user_name",
      "description": "获准输出的负责人姓名",
      "type": "string",
      "nullable": true
    },
    {
      "name": "name_variants",
      "description": "姓名版本数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    }
  ],
  "aliases": [
    "项目负责人",
    "专业群负责人"
  ],
  "semantics": [
    "姓名版本不唯一时先确认；不输出人员编号或联系方式"
  ]
}
