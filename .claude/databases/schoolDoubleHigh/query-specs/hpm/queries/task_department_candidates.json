{
  "name": "任务主部门名称候选",
  "description": "从有效双高年度任务的主部门解析业务名称，保留同名不同部门及名称版本。",
  "version": 1,
  "grain": "main department + name",
  "parameters": {
    "name_pattern": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "名称 LIKE 模式，参数值可含通配符；null 列出授权范围候选，不允许 LIMIT 1 消歧"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    }
  },
  "output": [
    {
      "name": "department_id",
      "description": "主部门键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "department_name",
      "description": "主部门名称",
      "type": "string",
      "nullable": true
    }
  ],
  "aliases": [
    "牵头部门",
    "任务负责部门"
  ],
  "semantics": [
    "任务自身 high_flag_=1；不由项目标记过滤",
    "当前库中所选阶段的当前进度；不是历史截止日快照",
    "仅在唯一主部门键且名称无冲突时继续；不能用 LIMIT 1 选首条"
  ]
}
