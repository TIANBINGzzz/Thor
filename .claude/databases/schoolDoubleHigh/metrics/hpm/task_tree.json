{
  "name": "年度任务树与标题数据集",
  "description": "返回任务名称、编码、父键和当前值，供正文标题及模板任务路径定位。",
  "version": 1,
  "grain": "project + stage + task",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    }
  },
  "output": [
    {
      "name": "project_id",
      "description": "项目键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "stage_id",
      "description": "阶段键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "task_id",
      "description": "任务键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "parent_id",
      "description": "父任务键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "task_name",
      "description": "任务标题",
      "type": "string",
      "nullable": true
    },
    {
      "name": "task_code",
      "description": "任务业务编码",
      "type": "string",
      "nullable": true
    },
    {
      "name": "task_level",
      "description": "任务层级",
      "type": "integer",
      "nullable": true
    },
    {
      "name": "target_value",
      "description": "当前目标原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "complete_value",
      "description": "当前完成值原文",
      "type": "string",
      "nullable": true
    },
    {
      "name": "current_progress",
      "description": "当前进度",
      "type": "number",
      "nullable": true,
      "unit": "%"
    }
  ],
  "aliases": [
    "任务树",
    "任务目标",
    "任务明细"
  ],
  "semantics": [
    "任务自身 high_flag_=1；不由项目标记过滤",
    "当前库中所选阶段的当前进度；不是历史截止日快照",
    "按项目+阶段+父路径+名称定位；编码或同名不能独立唯一定位",
    "只在同项目同阶段组装任务树，完整读取后检查缺父节点/循环；值可为定性文字",
    "task_id 在项目内唯一；标题必须唯一命中后使用"
  ]
}
