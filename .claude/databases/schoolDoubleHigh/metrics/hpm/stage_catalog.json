{
  "name": "项目阶段与年度目录",
  "description": "在已授权项目内按阶段名称定位年度，保留跨项目同名阶段。",
  "version": 1,
  "grain": "project + stage",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    }
  },
  "output": [
    {
      "name": "project_id",
      "description": "项目内部键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "stage_id",
      "description": "阶段内部键",
      "type": "string",
      "nullable": true,
      "visibility": "internal_only"
    },
    {
      "name": "stage_name",
      "description": "年度/阶段名称",
      "type": "string",
      "nullable": true
    },
    {
      "name": "start_time",
      "description": "阶段开始时间",
      "type": "string",
      "nullable": true
    },
    {
      "name": "end_time",
      "description": "阶段结束时间",
      "type": "string",
      "nullable": true
    },
    {
      "name": "current_flag",
      "description": "当前阶段标记",
      "type": "string",
      "nullable": true
    }
  ],
  "aliases": [
    "年度阶段",
    "项目年度"
  ],
  "semantics": [
    "同项目同名阶段多条须消歧；不能把全校年度解析为单一 stage_id"
  ]
}
