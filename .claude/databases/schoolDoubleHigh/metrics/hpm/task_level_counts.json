{
  "name": "年度任务层级数量",
  "description": "按任务实际层级分组，覆盖 Q1 和单独三级数量查询。",
  "version": 1,
  "grain": "task level",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    }
  },
  "output": [
    {
      "name": "task_level",
      "description": "任务层级",
      "type": "integer",
      "nullable": true
    },
    {
      "name": "task_count",
      "description": "该层级任务数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    }
  ],
  "aliases": [
    "各级任务数量",
    "任务层级数量"
  ],
  "semantics": [
    "任务自身 high_flag_=1；不由项目标记过滤",
    "当前库中所选阶段的当前进度；不是历史截止日快照",
    "不连接项目或一对多表；各层级之和等于同范围任务总数"
  ]
}
