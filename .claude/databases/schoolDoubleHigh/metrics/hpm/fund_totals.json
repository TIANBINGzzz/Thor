{
  "name": "年度及累计资金金额与比例",
  "description": "覆盖 Q13-Q15，分别提供预算、投入、执行、到位及三个不同分母的比例。",
  "version": 1,
  "grain": "selected level-1 annual funds",
  "parameters": {
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "authorized_resolution",
      "description": "已授权且唯一定位的项目；null 仅在当前租户全项目查询获准时允许"
    },
    "tenant_id": {
      "type": "string",
      "required": true,
      "origin": "authorized_context",
      "description": "执行端注入已授权租户，不能由模型或浏览器选择"
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "required": true,
      "origin": "user_intent",
      "description": "精确匹配阶段名称；null 为全部有阶段记录，不代表历史截止日"
    }
  },
  "output": [
    {
      "name": "fund_count",
      "description": "资金节点数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "budget_amount",
      "description": "预算已填金额合计",
      "type": "number",
      "nullable": true,
      "unit": "万元"
    },
    {
      "name": "budget_observed_count",
      "description": "预算非空金额记录数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "investment_amount",
      "description": "投入已填金额合计",
      "type": "number",
      "nullable": true,
      "unit": "万元"
    },
    {
      "name": "investment_observed_count",
      "description": "投入非空金额记录数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "execute_amount",
      "description": "执行已填金额合计",
      "type": "number",
      "nullable": true,
      "unit": "万元"
    },
    {
      "name": "execute_observed_count",
      "description": "执行非空金额记录数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "arrival_amount",
      "description": "到位已填金额合计",
      "type": "number",
      "nullable": true,
      "unit": "万元"
    },
    {
      "name": "arrival_observed_count",
      "description": "到位非空金额记录数",
      "type": "integer",
      "nullable": false,
      "unit": "条"
    },
    {
      "name": "budget_execution_rate",
      "description": "完整执行合计/完整预算合计",
      "type": "number",
      "nullable": true,
      "unit": "%"
    },
    {
      "name": "arrival_rate",
      "description": "完整到位合计/完整预算合计",
      "type": "number",
      "nullable": true,
      "unit": "%"
    },
    {
      "name": "arrival_execution_rate",
      "description": "完整执行合计/完整到位合计",
      "type": "number",
      "nullable": true,
      "unit": "%"
    }
  ],
  "aliases": [
    "资金执行率",
    "预算执行率",
    "资金预算",
    "资金总额",
    "年度资金",
    "资金到位率"
  ],
  "semantics": [
    "单位万元；一级资金节点且 stage_id_ 非空，排除父子层级和无阶段汇总重复",
    "year=null 汇总所有年度；年度记录的当前值不等于过去截止日快照",
    "SUM 保留 NULL：全无值为 null，部分有值是已填部分；observed_count<fund_count 不得宣称完整金额",
    "不将 NULL 金额补成 0；不将比例强制封顶；负金额只标记需核实，不臆造不允许冲销的业务规则",
    "分母0、无记录、分子分母存在未填金额时比例=null",
    "fund_count=0 与非空记录且金额=0 分开解释",
    "投入不是执行；不能把到位率自动填成含义未明确的收入预算执行率"
  ]
}
