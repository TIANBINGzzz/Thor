# 共用启动引导；本机实际参数写入 .env.local，客户配置见 config/README.md。
CCSDK_NACOS_URL=http://localhost:8848 # Nacos HTTP 地址，容器中改为可访问的主机地址。
CCSDK_NACOS_NAMESPACE="" # Nacos 命名空间 ID，空值表示 public。
CCSDK_NACOS_GROUP=DEFAULT_GROUP # Nacos 配置分组。
CCSDK_NACOS_DATA_ID=ai-center-agent-service # 客户 YAML 配置的 Data ID。
CCSDK_NACOS_USERNAME="" # Nacos 只读账号，可匿名时留空。
CCSDK_NACOS_PASSWORD="" # Nacos 登录密码，与账号同时配置。
# CCSDK_OFFICECLI_PATH=officecli # 可选的 OfficeCLI 可执行文件位置。
# HTTPS_PROXY=http://localhost:7897 # 可选的出站 HTTPS 代理。
# HTTP_PROXY=http://localhost:7897 # 可选的出站 HTTP 代理。
# NO_PROXY=localhost,127.0.0.1 # 无需代理的主机。
