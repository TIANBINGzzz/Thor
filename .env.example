# 复制为 .env 并填写部署凭据；本机差异写 .env.local，二者均不提交 Git。
# 加载顺序：.env -> .env.local -> 所选 Workflow 的 workflow.env。
# Regular Alibaba Cloud Model Studio pay-as-you-go API key (Beijing region):
ANTHROPIC_AUTH_TOKEN=YOUR_QWEN_API_KEY
ANTHROPIC_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/apps/anthropic

# Nacos 连接参数见 config/application.yml；此处只保存认证凭据。
CCSDK_NACOS_USERNAME=
CCSDK_NACOS_PASSWORD=

# Java -> Python internal Runtime authentication. Keep this secret server-side;
# production should use RS256/EdDSA plus mTLS instead of a shared HMAC key.
CCSDK_RUNTIME_JWT_SECRET=very-long-
CCSDK_RUNTIME_JWT_AUDIENCE=ccsdk-runtime
CCSDK_RUNTIME_JWT_ISSUER=string-ai-center-service

# 默认按 Nacos 的 fileService 下载本轮授权 fileId；
# baseUrl/domainName/remoteUrl 与上传共用，downloadPath 显式配置。
# 独立部署及本地自测可指定下面的 POST Broker；不是下载失败后的回退。
# Broker 返回代理流或带 expiresAt/oneTime 的授权 URL，URL 模式须配置允许 Host。
# CCSDK_FILE_BROKER_URL=https://string-ai-center-service/internal/v1/file-access/grant
# 执行、排队、文件及工具超时、大小和轮数限制统一在 config/application.yml 的 runtime 下配置。
# 可选生图；使用同地域百炼空间的OpenAI Images兼容接口，密钥仅进入内部生图工具。
# CCSDK_IMAGE_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# CCSDK_IMAGE_API_KEY=<image-api-key>
# CCSDK_IMAGE_MODEL=qwen-image-3.0
# CCSDK_OFFICECLI_PATH=officecli
# Required for URL mode, and recommended whenever the endpoint can return URLs.
# CCSDK_FILE_BROKER_ALLOWED_HOSTS=objects.example.com
# CCSDK_FILE_BROKER_AUTH_MODE=run_jwt
# Optional mTLS files, relative to the Runtime process working directory.
# CCSDK_FILE_BROKER_CA=./certs/java-ca.pem
# CCSDK_FILE_BROKER_CLIENT_CERT=./certs/runtime-client.crt
# CCSDK_FILE_BROKER_CLIENT_KEY=./certs/runtime-client.key
# Deployment-side credential for service mode. run_jwt and service are mutually
# exclusive; never use credentials.platformBearer here.
# CCSDK_FILE_BROKER_SERVICE_TOKEN=replace-with-service-token

# 独立观测出口：开关、实例名及保留策略放 config/observability.local.yml。
# 采集密钥独立于业务 Token、Run JWT 和模型密钥，仅 Runtime 与 Hawkeye 服务端持有。
# CCSDK_OBSERVATION_TOKEN=填写独立生成的采集密钥
# CCSDK_OBSERVABILITY_ENABLED=0 可紧急停采；设置后覆盖 YAML 的 enabled。

# 模型默认值、可用列表及 SDK 映射统一配置在 config/application.yml 的 runtime.models。

# For a Singapore-region key, use:
# ANTHROPIC_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/apps/anthropic

# For a Coding Plan key, set the base URL below and configure compatible models in config/application.yml:
# ANTHROPIC_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic

# Protected data configuration, resolved relative to the repository root.
# Start from deploy/data-access.example.json; configure explicit identity/scope,
# read-only connection and a trusted database TLS CA in config/databases.json.
# CCSDK_DATABASES_FILE=config/databases.json

# 本机需要代理时仅在 .env.local 配置，生产默认直连。
# 取消代理须删除实际环境文件及启动环境中的变量；本模板的注释不会清除已注入的代理。
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,.aliyuncs.com
