# The endpoint must implement Anthropic's Messages API, not only OpenAI chat/completions.
ANTHROPIC_AUTH_TOKEN=replace-with-your-token
ANTHROPIC_BASE_URL=https://your-anthropic-compatible-endpoint.example.com
ANTHROPIC_MODEL=qwen-your-model

# Optional: map Claude's internal model tiers to the same compatible model.
ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen-your-model
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen-your-model
ANTHROPIC_DEFAULT_OPUS_MODEL=qwen-your-model
CLAUDE_CODE_SUBAGENT_MODEL=qwen-your-model

