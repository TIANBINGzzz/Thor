# Copy this file to .env, then replace every placeholder.
# Regular Alibaba Cloud Model Studio pay-as-you-go API key (Beijing region):
ANTHROPIC_AUTH_TOKEN=YOUR_QWEN_API_KEY
ANTHROPIC_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=qwen3.7-max

# Optional defaults used by Claude Code internals.
ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.6-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.7-max
ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.7-max
CLAUDE_CODE_SUBAGENT_MODEL=qwen3.7-max

# For a Singapore-region key, use:
# ANTHROPIC_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/apps/anthropic

# For a Coding Plan key, replace the base URL and model values with:
# ANTHROPIC_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
# ANTHROPIC_MODEL=qwen3.7-plus
# ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.7-plus
# ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.7-plus
# ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.7-plus
# CLAUDE_CODE_SUBAGENT_MODEL=qwen3.7-plus

# Database connection. Uncomment one line and replace its placeholders.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?sslmode=require
# DATABASE_URL=mariadb://USER:PASSWORD@HOST:3306/DATABASE?sslmode=require
# DATABASE_URL=sqlserver://USER:PASSWORD@HOST:1433/DATABASE?sslmode=require
# DATABASE_URL=sqlite:///D:/path/to/database.db

# 本机代理（需要 WebFetch 访问境外站点时填写，端口按你的客户端改）。
# claude.exe 不读 Windows 系统代理，只认这几个变量。
# NO_PROXY 必须排除百炼网关，否则国内直连的流量会被绕出去。
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1,.aliyuncs.com
