# 复制为 .env 并填写实际值；.env.local 仅作可选覆盖，无需重复维护。
# 模型、图像、JWT、数据库及业务服务统一配置在 Nacos，字段见 config/README.md。
CCSDK_NACOS_URL=http://localhost:8848 # Nacos HTTP 地址，启动前必须可访问。
CCSDK_NACOS_NAMESPACE="" # Nacos 命名空间 ID，空值表示 public。
CCSDK_NACOS_GROUP=DEFAULT_GROUP # Nacos 配置分组。
CCSDK_NACOS_DATA_ID=ai-center-agent-service # 客户 YAML 配置的 Data ID。
CCSDK_NACOS_USERNAME="" # Nacos 只读账号，可匿名时留空。
CCSDK_NACOS_PASSWORD="" # Nacos 登录密码，与账号同时配置。

CCSDK_OFFICECLI_PATH=${LOCALAPPDATA}/OfficeCLI/1.0.151/officecli.exe # Windows 本机已安装的位置；其他环境填写实际路径。
# CCSDK_LIBREOFFICE_PATH=soffice # 可选的 LibreOffice 入口，不指定时自动查找。
# CCSDK_UNO_PYTHON=python3 # 可选的 UNO Python 入口，须具备与 LibreOffice 配套的 UNO 模块。
CCSDK_RENDER_IMAGE=ccsdkscribe-renderer:local # Windows 本机文档渲染容器镜像。
SCRIBE_PORT=4310 # Runtime 本机监听端口。
SCRIBE_RUN_DB=.scribe-runs/runs.sqlite3 # Run 库路径，相对启动工作目录；从仓库根目录启动。

# HTTPS_PROXY=http://127.0.0.1:7897 # 需要出站 HTTPS 代理时启用。
# HTTP_PROXY=http://127.0.0.1:7897 # 需要出站 HTTP 代理时启用。
NO_PROXY=localhost,127.0.0.1,.aliyuncs.com # 本机及百炼模型网关直连。
