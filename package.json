{
  "name": "thor",
  "version": "1.0.0",
  "description": "Claude Agent SDK runner and web workspace configured for Anthropic-compatible model endpoints",
  "main": "app/index.mjs",
  "scripts": {
    "start": "node app/index.mjs",
    "agent": "node app/index.mjs",
    "ui": "npm run web:build && node app/ui.mjs",
    "ui:dev": "node app/ui.mjs --dev",
    "ui:backend": "node app/server.mjs",
    "web": "npm --prefix web run dev",
    "web:start": "npm --prefix web run start",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "db:demo": "node app/db-demo.mjs",
    "check:app": "node --check app/index.mjs && node --check app/database.mjs && node --check app/db-demo.mjs && node --check app/agent-options.mjs && node --check app/sse-events.mjs && node --check app/session-files.mjs && node --check app/references.mjs && node --check app/server.mjs && node --check app/ui.mjs",
    "test": "npm run check:app && node --test app/*.test.mjs",
    "create-skill": "node scripts/create-skill.mjs"
  },
  "keywords": [
    "claude-agent-sdk",
    "qwen"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.231",
    "@bytebase/dbhub": "^1.2.0",
    "busboy": "1.6.0",
    "dotenv": "^17.4.2",
    "marked": "18.0.9"
  },
  "overrides": {
    "@modelcontextprotocol/node": {
      "@hono/node-server": "^2.1.0"
    }
  }
}
