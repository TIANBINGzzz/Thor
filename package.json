{
  "name": "thor",
  "version": "1.0.0",
  "description": "Java-facing Claude Agent SDK runtime",
  "scripts": {
    "start": "python python/server.py",
    "check:app": "python -m compileall -q python && python -m unittest discover -s python/tests -t python -p \"test_*.py\"",
    "test": "npm run check:app"
  },
  "keywords": [
    "claude-agent-sdk",
    "python-sdk",
    "qwen"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@modelcontextprotocol/node": {
      "@hono/node-server": "^2.1.0"
    }
  }
}
