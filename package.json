{
  "name": "thor",
  "version": "1.0.0",
  "description": "Claude Agent SDK runner and web workspace configured for Anthropic-compatible model endpoints",
  "scripts": {
    "start": "python python/cli.py",
    "agent": "python python/cli.py",
    "ui": "python python/ui.py",
    "ui:dev": "python python/ui.py --dev",
    "ui:backend": "python python/server.py",
    "web": "npm --prefix web run dev",
    "web:start": "npm --prefix web run start",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "db:demo": "python python/cli.py --db-demo",
    "check:app": "python -m compileall -q python && python -m unittest discover -s python/tests -t python -p \"test_*.py\"",
    "test": "npm run check:app"
  },
  "keywords": [
    "claude-agent-sdk",
    "python-sdk",
    "qwen"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bytebase/dbhub": "^1.2.0"
  },
  "overrides": {
    "@modelcontextprotocol/node": {
      "@hono/node-server": "^2.1.0"
    }
  }
}
