    {
      "ref": "get_norm_metrics",
      "displayKey": "data.query",
      "description": "查询本校在自选学校组的常模统计。每轮（包括年份追问或更换学校）先读取本轮身份，传指标 code 和学校 code；剔除本校并去重后至少 12 所。不得复用上轮身份授权。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "indicator_code": {
                "type": "string",
                "minLength": 1,
                "description": "所选指标知识记录的 code，不能传指标名称。"
              },
              "year": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              },
              "schools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "所选学校目录记录的 code 数组（保留前导零），不能传学校名称。"
              }
            },
            "required": [
              "indicator_code",
              "schools"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "indicator_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "median": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "rank": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "max_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "min_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "average_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "school_count": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "year": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": false
      },
      "handler": "get_norm_metrics"
    }
  ]
}
