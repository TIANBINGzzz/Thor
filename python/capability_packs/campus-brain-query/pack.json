{
  "ref": "campus-brain-query",
  "services": [
    "campus"
  ],
  "operations": [
    {
      "ref": "execute_query_plan",
      "displayKey": "data.query",
      "description": "执行整题校园问数计划，优先一次提交全部指标、年份和统计项。本校/预置群体必须显式填写scopes；漏项可在本轮预算内补查新scopes，已查项复用结果。常模使用完整schools且不得传scopes。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "enum": ["current_school", "norm_group"]
          },
          "schools": {
            "description": "仅常模计划传完整学校编码列表；current_school 必须省略此字段。",
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "item_id": {"type": "string", "minLength": 1, "maxLength": 64},
                "indicator_code": {"type": "string", "minLength": 1},
                "year": {"type": "integer", "minimum": 1000, "maximum": 9999},
                "scopes": {
                  "description": "本校值及预置群体所需统计项；只查本校也必须填写indicator_value，多个统计项一次列全。常模不得填写。",
                  "type": "array",
                  "items": {"type": "string", "enum": [
                    "indicator_value", "province_rank", "province_median", "national_median",
                    "same_type_rank", "same_type_median", "national_double_high_median",
                    "province_double_high_median", "national_double_high_simulated_rank",
                    "province_double_high_simulated_rank", "private_median"
                  ]},
                  "minItems": 1,
                  "uniqueItems": true
                },
                "schools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
              },
              "required": ["item_id", "indicator_code"],
              "additionalProperties": false
            }
          }
        },
        "required": ["subject", "items"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
          "planned": {"type": "integer"},
          "executed": {"type": "integer"},
          "complete": {"type": "boolean"},
          "status": {"type": "string", "enum": ["completed", "partial", "blocked"]},
          "reason": {"type": "string", "enum": ["identity_unavailable"]}
        },
        "required": ["items", "planned", "executed", "complete"],
        "additionalProperties": false
      },
      "handler": "execute_query_plan"
    },
    {
      "ref": "search_knowledge",
      "displayKey": "data.prepare",
      "description": "批量检索指标或常模学校；常模指标用 norm_analysis。多个候选直接选最贴近名称的一项，同样合理时取首项，不停下来澄清；回答展示所选全称。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "indicator_compare",
              "norm_analysis",
              "schools"
            ]
          },
          "query": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "minItems": 1,
                "maxItems": 30
              }
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "total": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean"
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      },
      "handler": "search_knowledge"
    },
    {
      "ref": "get_school_info",
      "displayKey": "data.resolve",
      "description": "读取当前登录本校；仅用于本校身份问题、明确本校名称的一致性校验或常模剔除本校，每轮最多一次。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "school_id": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "school_name": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": false
      },
      "handler": "get_school_info"
    },
    {
      "ref": "get_indicator_metrics",
      "displayKey": "data.query",
      "description": "查询所选的一个本校指标及预置群体统计。编码来自对比分析知识记录；年份省略表示最新。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "indicator_code": {
                "type": "string",
                "minLength": 1,
                "description": "所选指标知识记录的 code，不能传指标名称。"
              },
              "year": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              },
              "scopes": {
                "description": "显式列出所需本校值和预置群体统计；只查本校传indicator_value。",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "indicator_value",
                    "province_rank",
                    "province_median",
                    "national_median",
                    "same_type_rank",
                    "same_type_median",
                    "national_double_high_median",
                    "province_double_high_median",
                    "national_double_high_simulated_rank",
                    "province_double_high_simulated_rank",
                    "private_median"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "indicator_code",
              "scopes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "indicator_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "province_rank": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "province_median": {
                    "type": [
                      "string",
                      "number",
