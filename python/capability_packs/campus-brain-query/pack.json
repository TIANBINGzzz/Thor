{
  "ref": "campus-brain-query",
  "services": [
    "campus"
  ],
  "operations": [
    {
      "ref": "search_knowledge",
      "displayKey": "data.prepare",
      "description": "批量检索指标或常模学校；常模指标用 norm_analysis。多个候选直接选最贴近名称的一项，同样合理时取首项，不停下来澄清；回答展示所选全称。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "indicator_compare",
              "norm_analysis",
              "schools"
            ]
          },
          "query": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "minItems": 1,
                "maxItems": 30
              }
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "total": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean"
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      },
      "handler": "search_knowledge"
    },
    {
      "ref": "get_school_info",
      "displayKey": "data.resolve",
      "description": "读取当前登录本校；仅用于本校身份问题、明确本校名称的一致性校验或常模剔除本校，每轮最多一次。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "school_id": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "school_name": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": false
      },
      "handler": "get_school_info"
    },
    {
      "ref": "get_indicator_metrics",
      "displayKey": "data.query",
      "description": "查询所选的一个本校指标及预置群体统计。编码来自对比分析知识记录；年份省略表示最新。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "indicator_code": {
                "type": "string",
                "minLength": 1,
                "description": "所选指标知识记录的 code，不能传指标名称。"
              },
              "year": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "indicator_value",
                    "province_rank",
                    "province_median",
                    "national_median",
                    "same_type_rank",
                    "same_type_median",
                    "national_double_high_median",
                    "province_double_high_median",
                    "national_double_high_simulated_rank",
                    "province_double_high_simulated_rank",
                    "private_median"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "indicator_code"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "indicator_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "province_rank": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "province_median": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "national_median": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "same_type_rank": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "same_type_median": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "national_double_high_median": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "province_double_high_median": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "national_double_high_simulated_rank": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "province_double_high_simulated_rank": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "private_median": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "year": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "rank_type": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "school_count": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "cohort_size": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "percentile": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": false
      },
      "handler": "get_indicator_metrics"
    },
    {
      "ref": "get_norm_metrics",
      "displayKey": "data.query",
      "description": "查询本校在自选学校组的常模统计。每轮（包括年份追问或更换学校）先调用 get_school_info，再传指标 code 和学校 code；剔除本校并去重后至少 8 所。不得复用上轮身份授权。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "indicator_code": {
                "type": "string",
                "minLength": 1,
                "description": "所选指标知识记录的 code，不能传指标名称。"
              },
              "year": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              },
              "schools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "所选学校目录记录的 code 数组（保留前导零），不能传学校名称。"
              }
            },
            "required": [
              "indicator_code",
              "schools"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "payload"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "indicator_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "median": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "rank": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "max_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "min_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "average_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "school_count": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "year": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": false
      },
      "handler": "get_norm_metrics"
    }
  ]
}
