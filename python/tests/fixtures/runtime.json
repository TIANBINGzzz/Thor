{
  "timeouts": {
    "execution-ms": 3600000,
    "client-queue-ms": 300000,
    "client-idle-ms": 300000,
    "file-prepare-ms": 600000,
    "file-download-ms": 15000,
    "file-upload-connect-ms": 10000,
    "worker-start-ms": 60000,
    "worker-send-ms": 5000,
    "worker-close-ms": 20000,
    "worker-control-ms": 5000,
    "document-render-ms": 180000,
    "document-start-ms": 30000,
    "image-ms": 600000,
    "web-search-ms": 90000,
    "mcp-http-ms": 30000
  },
  "limits": {
    "max-turns": 200,
    "file-max-bytes": 268435456,
    "sdk-buffer-bytes": 16777216,
    "http-body-bytes": 2097152,
    "prompt-bytes": 32768,
    "web-search-max-tokens": 600,
    "web-search-thinking-max-tokens": 4096
  },
  "sse-heartbeat-ms": 15000,
  "models": {
    "default": "deepseek-v4.1-flash",
    "available": [
      "deepseek-v4.1-flash",
      "qwen3.8-flash",
      "qwen3.8-max"
    ],
    "sdk": {
      "haiku": "deepseek-v4.1-flash",
      "sonnet": "deepseek-v4.1-flash",
      "opus": "qwen3.8-max",
      "subagent": "deepseek-v4.1-flash"
    }
  },
  "worker-pool": {
    "max-idle": 6,
    "max-starting": 2,
    "max-live": 24,
    "min-available-memory-mib": 1024
  },
  "observability": {
    "enabled": false,
    "storage": ".scribe-runs/observation.sqlite",
    "max-records": 20000,
    "retention-seconds": 86400,
    "queue-size": 2048
  }
}
